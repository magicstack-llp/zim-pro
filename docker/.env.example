# Copy to .env and change what you need. Every line is optional unless it says otherwise;
# the value shown is the default.

# --- Zim Pro (all files) ---------------------------------------------------------------
# Who the container runs as: must be able to write to both folders below. `id -u`, `id -g`
PUID=1000
PGID=1000
# The port the web interface is on: http://localhost:8083
PORT=8083
# Your folder of .zim files, and a folder for the database. Create them first
# (`mkdir -p zims state`), or Docker creates them as root.
ZIM_DIR=./zims
STATE_DIR=./state
# A password for changes and for /mcp. Empty: none is asked for.
ADMIN_TOKEN=
# The image version: latest, or a release such as 0.3.0
ZIM_PRO_TAG=latest
TZ=Etc/UTC

# --- VPN (compose.vpn.yml, compose.vpn-all.yml, compose.full.yml): REQUIRED there --------
# From your provider; the Gluetun wiki lists them: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=Netherlands
# The key Zim Pro sends to Gluetun's control server. Make one: openssl rand -hex 24
# Put the same value in Settings -> Network -> Control server API key.
VPN_CONTROL_KEY=

# --- compose.vpn-external.yml: REQUIRED there ---------------------------------------------
# The Docker network your existing Gluetun container is on.
VPN_NETWORK=

# --- Browser capture (compose.zimit.yml, compose.full.yml) --------------------------------
# The docker group's id on this machine: getent group docker | cut -d: -f3
DOCKER_GID=999
